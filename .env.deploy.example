# Read only at deploy time, by rocketship.py. Copy to `.env.deploy` and fill in.
#
#     cp .env.deploy.example .env.deploy && chmod 600 .env.deploy
#
# This file holds two different things: the production settings the running app
# needs, and the credentials this machine needs to talk to Azure. Only the first
# is uploaded - rocketship.py's NOT_FOR_DEPLOYMENT list drops the second, and
# prints what it dropped.
#
# `.env` is the local development file and is never read here. Keeping them
# apart is what stops a local value shipping to production, and stops a bare
# `manage.py` run on your machine connecting to the Azure database.
#
# Values pinned in config/azure-deploy.yml's additional_env (ENVIRONMENT,
# WEBSITES_*, CONFIG_FILE_PATH, LITELLM_DB_SCHEMA, LITELLM_ENABLE_VIRTUAL_KEYS,
# LITELLM_PROXY_BASE_URL, DISABLE_ADMIN_UI, CUSTOM_HOSTNAME) do NOT belong here
# - that file wins on conflicts, so setting them in both is a second source of
# truth that will eventually disagree.
#
# See docs/DEPLOYMENT.md for where each value comes from.

# --- Deploy credentials (stripped before upload) ---------------------------
# az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID=

# az acr credential show -n <registry> --query 'passwords[0].value' -o tsv
# The registry's admin user must be enabled.
ROCKETSHIP_REGISTRY_PASSWORD=

# --- Django ----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# sslmode=require is not optional; Flexible Server refuses plaintext.
DATABASE_URL=postgres://user:pass@your-server.postgres.database.azure.com:5432/yourdb?sslmode=require

# Seeds a superuser through migration 0002 on a database with no user at this
# address. Set before the first deploy, or create the superuser by hand later.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Identity comes from App Service Authentication. Left unset, settings.py infers
# it from WEBSITE_HOSTNAME - which App Service always sets - so Easy Auth is ON
# by default. Set this to a literal `false` on any Web App where Authentication
# is NOT turned on: there X-MS-CLIENT-PRINCIPAL-NAME is client-controlled and
# trusting it lets anyone sign in as anyone.
# An empty value is skipped rather than pushed, so `false` must be literal.
#EASYAUTH_ENABLED=false

# --- Azure OpenAI ----------------------------------------------------------
# Resolved from the environment at boot by config/litellm-config.yaml. The
# deployment names there must match deployments that exist on this resource.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=v1

# --- LiteLLM ---------------------------------------------------------------
# Authenticates the proxy's admin API and Django's calls into it.
# NOTE: LITELLM_SALT_KEY is unset, so LiteLLM also uses this as the encryption
# salt for anything it stores in the database. Changing it after the fact makes
# those values undecryptable - decide it once.
LITELLM_MASTER_KEY=

# The model the quickstart snippets suggest. Default: gpt-5
LITELLM_DEFAULT_MODEL=gpt-5

# --- Per-key limits (optional; defaults shown) -----------------------------
#LITELLM_KEY_MAX_BUDGET=10           # USD per budget period, 0 = unlimited
#LITELLM_KEY_BUDGET_DURATION=1mo     # "1mo" = calendar month; "30d" = rolling
#LITELLM_KEY_RPM_LIMIT=60
#LITELLM_KEY_TPM_LIMIT=200000
#LITELLM_KEY_DURATION=180d
#LITELLM_KEY_DEFAULT_MODELS=         # comma-separated; empty = all proxy models

# --- One-boot escape hatch -------------------------------------------------
# entrypoint.sh runs `prisma db push` WITHOUT --accept-data-loss, so a LiteLLM
# schema change that would drop columns fails the boot instead of destroying the
# key and spend tables. Set true for the single boot that applies such an
# upgrade, then REMOVE IT AGAIN - left on, it silently re-arms that failure mode
# for every future LiteLLM version bump.
#LITELLM_PRISMA_ACCEPT_DATA_LOSS=true
