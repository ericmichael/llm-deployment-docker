# Local development only. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# Docker Compose reads this file; `manage.py` and `gateway/settings.py` read it
# too, via load_dotenv(). Deployment does NOT read it - see .env.deploy.example.
#
# Never put a production DATABASE_URL here. settings.py loads this file, so a
# bare `manage.py` run would connect to production.

# --- Django ---------------------------------------------------------------
# Any random string locally. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-not-a-real-secret

# "development" or "test" turns DEBUG on and relaxes the security settings;
# anything else (i.e. "production") turns them on. Default: development
ENVIRONMENT=development

# Local Postgres. Docker Compose overrides this to point at its own container,
# so this value is what a bare `manage.py` run on the host uses.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aistarterkit

# Seeds a superuser through migration 0002, but only on a database that has no
# user at this address yet. Leave the password blank to skip and use
# `manage.py createsuperuser` instead.
DEFAULT_ADMIN_EMAIL=you@example.edu
DEFAULT_ADMIN_PASSWORD=change-me

# --- Azure OpenAI ---------------------------------------------------------
# Read from the environment at boot by config/litellm-config.yaml. Required for
# the proxy to serve anything; also needed to re-record the e2e cassettes.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=v1

# --- LiteLLM --------------------------------------------------------------
# Authenticates the proxy's admin API and Django's calls into it. Any opaque
# string; the "sk-" prefix in LiteLLM's docs is a convention, not a requirement.
# NOTE: LITELLM_SALT_KEY is unset, so LiteLLM also uses this as the encryption
# salt for credentials it stores in the database. Changing it later makes those
# undecryptable.
LITELLM_MASTER_KEY=dev-master-key

# Keeps LiteLLM's Prisma tables out of Django's schema. Default: litellm
LITELLM_DB_SCHEMA=litellm

# Set false to hide the key UI entirely. Default: false
LITELLM_ENABLE_VIRTUAL_KEYS=true

# Where Django reaches the proxy's management API. In the unified app the proxy
# is mounted in the same process. Default: http://localhost:8000/litellm
LITELLM_PROXY_BASE_URL=http://localhost:8000/litellm

# The model the quickstart snippets suggest. Default: gpt-5
LITELLM_DEFAULT_MODEL=gpt-5

# The proxy's model definitions. This is the container path Docker Compose
# mounts; running outside the container, use config/litellm-config.yaml.
CONFIG_FILE_PATH=/usr/src/app/config/litellm-config.yaml

# --- Per-key limits (optional; defaults shown) -----------------------------
# Every generated key gets these. `manage.py sync_litellm_keys` re-pushes them
# to existing keys at every boot. 0 means unlimited.
#LITELLM_KEY_MAX_BUDGET=10           # USD per budget period
#LITELLM_KEY_BUDGET_DURATION=1mo     # "1mo" = calendar month; "30d" = rolling
#LITELLM_KEY_RPM_LIMIT=60
#LITELLM_KEY_TPM_LIMIT=200000
#LITELLM_KEY_DURATION=180d           # key expiry, roughly a semester
#LITELLM_KEY_DEFAULT_MODELS=         # comma-separated; empty = all proxy models

# --- Rarely needed locally -------------------------------------------------
# Trust the X-MS-CLIENT-PRINCIPAL-NAME header from App Service Authentication.
# Unset, settings.py infers it from WEBSITE_HOSTNAME, which is never set
# locally - so this is off in development and you log in with a password.
#EASYAUTH_ENABLED=false
#CUSTOM_HOSTNAME=
#DJANGO_ADDITIONAL_ALLOWED_HOSTS=
#DJANGO_HEALTHCHECK_HOSTS=169.254.130.2
